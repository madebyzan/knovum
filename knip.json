{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tests/e2e/**/*.e2e.ts",
    "src/foundation/secrets/secret-store.ts",
    "src/**/*.css",
    "scripts/*/__tests__/*.test.mjs",
    "scripts/*/__tests__/*.integration.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,vue}",
    "src/**/*.css",
    "tests/e2e/**/*.ts",
    "scripts/**/*.mjs",
    "*.config.{ts,mts,cjs,mjs}",
    ".*.cjs"
  ],
  "cycles": {
    "dynamicImports": true
  },
  "ignoreBinaries": ["minisign", "uv"],
  "ignoreDependencies": ["@wdio/local-runner"]
}
