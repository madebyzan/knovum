{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-resources",
  "description": "Main-window access to installed local processing tools and models.",
  "windows": ["main"],
  "permissions": [
    "local-resources:allow-get-status",
    "local-resources:allow-prepare-resources",
    "local-resources:allow-cancel-resource-preparation",
    "local-resources:allow-list-resource-preparations",
    "local-resources:allow-get-model-catalog",
    "local-resources:allow-remove-model",
    "local-resources:allow-select-local-model"
  ]
}
