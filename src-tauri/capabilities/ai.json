{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-runtime",
  "description": "Main-window access to the Rust AI runtime and its persistent workbench state.",
  "windows": ["main"],
  "permissions": [
    "ai:allow-await-ai-runtime",
    "ai:allow-cancel-job",
    "ai:allow-detect-external-agent-installations",
    "ai:allow-list-external-agent-descriptors",
    "ai:allow-list-provider-descriptors",
    "ai:allow-get-token-usage-report",
    "ai:allow-transform-editor-text-stream",
    "ai:allow-translate-text-stream",
    "ai:allow-validate-model-settings"
  ]
}
