{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop",
  "description": "Permissions required by the current desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "log:default",
    "store:default",
    "os:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-request-user-attention",
    "dialog:default",
    "secrets:allow-get",
    "secrets:allow-is-configured",
    "secrets:allow-set",
    "secrets:allow-delete",
    "desktop:allow-set-locale",
    "desktop:allow-set-workspace-menu-state",
    "desktop:allow-reveal-main-window",
    "desktop:allow-mark-exit-coordinator-ready",
    "desktop:allow-acknowledge-app-exit-request",
    "desktop:allow-report-startup-failure",
    "desktop:allow-project-session-tasks",
    "desktop:allow-set-task-notifications",
    "desktop:allow-perform-editing",
    "desktop:allow-begin-window-close",
    "desktop:allow-acknowledge-window-close",
    "desktop:allow-complete-window-close",
    "desktop:allow-decide-app-exit-request"
  ]
}
