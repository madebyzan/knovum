{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dictation",
  "description": "Main-window access to the Rust-owned dictation session and result state.",
  "windows": ["main"],
  "platforms": ["macOS", "windows"],
  "permissions": [
    "dictation:allow-get-state",
    "dictation:allow-cancel",
    "dictation:allow-dismiss-transcription",
    "dictation:allow-copy-transcription",
    "dictation:allow-get-dictation-shortcut",
    "dictation:allow-set-dictation-shortcut",
    "dictation:allow-reset-dictation-shortcut"
  ]
}
