if(WIN32)
  set(platform windows)
  set(onnx_name onnxruntime.dll)
else()
  set(platform macos)
  set(onnx_name libonnxruntime.1.22.1.dylib)
endif()
string(JSON supplier GET "${onnx_record}" onnxRuntime ${platform})
knovum_download("${supplier}" "${CMAKE_BINARY_DIR}/onnx.whl")
file(ARCHIVE_EXTRACT INPUT "${CMAKE_BINARY_DIR}/onnx.whl" DESTINATION "${CMAKE_BINARY_DIR}/onnx")
file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}")
file(COPY_FILE "${CMAKE_BINARY_DIR}/onnx/onnxruntime/capi/${onnx_name}" "${CMAKE_INSTALL_PREFIX}/${onnx_name}")
file(COPY_FILE "${CMAKE_BINARY_DIR}/onnx/onnxruntime/LICENSE" "${CMAKE_INSTALL_PREFIX}/ONNX-RUNTIME-LICENSE")
file(COPY_FILE "${CMAKE_BINARY_DIR}/onnx/onnxruntime/ThirdPartyNotices.txt" "${CMAKE_INSTALL_PREFIX}/ONNX-RUNTIME-NOTICES")
if(WIN32)
  file(COPY_FILE "${CMAKE_BINARY_DIR}/onnx/onnxruntime/capi/onnxruntime_providers_shared.dll" "${CMAKE_INSTALL_PREFIX}/onnxruntime_providers_shared.dll")
endif()
# Check original supplier bytes before relocation/signing, against the qualified inventory.
string(JSON count LENGTH "${onnx_record}" files ${KNOVUM_TARGET})
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON path GET "${onnx_record}" files ${KNOVUM_TARGET} ${i} path)
  string(JSON expected GET "${onnx_record}" files ${KNOVUM_TARGET} ${i} sha256)
  file(SHA256 "${CMAKE_INSTALL_PREFIX}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "ONNX supplier byte inventory differs: ${path}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/ort-headers" "${CMAKE_BINARY_DIR}/ort-lib")
string(JSON count LENGTH "${sherpa_record}" headers)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON header GET "${sherpa_record}" headers ${i})
  string(JSON name GET "${header}" fileName)
  knovum_download("${header}" "${CMAKE_BINARY_DIR}/ort-headers/${name}")
endforeach()
if(WIN32)
  string(JSON supplier GET "${sherpa_record}" windowsImportLibrary)
  knovum_download("${supplier}" "${CMAKE_BINARY_DIR}/ort-import.zip")
  file(ARCHIVE_EXTRACT INPUT "${CMAKE_BINARY_DIR}/ort-import.zip" DESTINATION "${CMAKE_BINARY_DIR}/ort-import")
  file(COPY "${CMAKE_BINARY_DIR}/ort-import/onnxruntime-win-x64-1.22.1/lib/onnxruntime.lib" DESTINATION "${CMAKE_BINARY_DIR}/ort-lib")
  file(COPY "${CMAKE_INSTALL_PREFIX}/onnxruntime.dll" DESTINATION "${CMAKE_BINARY_DIR}/ort-lib")
  # sherpa-onnx links a pre-installed Windows onnxruntime through the import library it reads from
  # location_onnxruntime_lib2, but derives that path only for GPU builds.
  set(sherpa_flags -Dlocation_onnxruntime_lib2=${CMAKE_BINARY_DIR}/ort-lib/onnxruntime.lib)
else()
  file(COPY_FILE "${CMAKE_INSTALL_PREFIX}/${onnx_name}" "${CMAKE_BINARY_DIR}/ort-lib/libonnxruntime.dylib")
  set(sherpa_flags)
endif()
