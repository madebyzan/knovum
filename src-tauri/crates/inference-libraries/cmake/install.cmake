if(WIN32)
  set(extension dll)
else()
  set(extension dylib)
endif()
file(GLOB_RECURSE libraries "${BUILD}/*.${extension}")
if(KIND STREQUAL "sherpa")
  list(FILTER libraries INCLUDE REGEX "/(lib)?sherpa-onnx-c-api\\.${extension}$")
  list(LENGTH libraries count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Sherpa C API library is missing or ambiguous")
  endif()
  list(GET libraries 0 library)
  file(MAKE_DIRECTORY "${PREFIX}/compiled-libraries")
  file(COPY_FILE "${library}" "${PREFIX}/compiled-libraries/sherpa-onnx-c-api.${extension}")
  file(GLOB_RECURSE notices "${BUILD}/_deps/*LICENSE*" "${BUILD}/_deps/*COPYING*" "${BUILD}/_deps/*NOTICE*")
  foreach(path IN LISTS notices)
    if(NOT IS_DIRECTORY "${path}")
      file(RELATIVE_PATH relative "${BUILD}/_deps" "${path}")
      get_filename_component(parent "${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${PREFIX}/source-notices/sherpa/dependencies/${parent}")
      file(COPY_FILE "${path}" "${PREFIX}/source-notices/sherpa/dependencies/${relative}")
    endif()
  endforeach()
else()
  file(GLOB_RECURSE modules "${BUILD}/*.so")
  list(APPEND libraries ${modules})
  if(NOT libraries)
    message(FATAL_ERROR "Whisper shared libraries are missing")
  endif()
  file(MAKE_DIRECTORY "${PREFIX}/compiled-libraries/whisper")
  foreach(path IN LISTS libraries)
    get_filename_component(name "${path}" NAME)
    file(COPY_FILE "${path}" "${PREFIX}/compiled-libraries/whisper/${name}")
  endforeach()
endif()
file(MAKE_DIRECTORY "${PREFIX}/source-notices/${KIND}")
file(COPY_FILE "${SOURCE}/LICENSE" "${PREFIX}/source-notices/${KIND}/LICENSE")
