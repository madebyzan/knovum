set(ENV{VSLANG} 1033)
set(dumpbin "@CMAKE_DUMPBIN@")
if(NOT dumpbin)
  unset(dumpbin)
  find_program(dumpbin NAMES dumpbin REQUIRED)
endif()
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/../../../build_support/windows-system-libraries.json" allowed)
set(system)
string(JSON count LENGTH "${allowed}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${allowed}" ${index})
  list(APPEND system "${name}")
endforeach()
# The inference worker loads these binaries with the DLL's own directory and the runtime root and
# bin/ ahead of System32 (inference-worker speech/ffi.rs). GET_RUNTIME_DEPENDENCIES searches System32
# first, so it would qualify the build host's runtime instead of the packaged one. Each import must
# therefore be packaged in one of those directories unless Windows owns it.
file(GLOB_RECURSE binaries "${CMAKE_INSTALL_PREFIX}/*.dll" "${CMAKE_INSTALL_PREFIX}/*.exe")
foreach(binary IN LISTS binaries)
  get_filename_component(owner "${binary}" DIRECTORY)
  execute_process(COMMAND "${dumpbin}" /dependents "${binary}" OUTPUT_VARIABLE listing COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\r" "" listing "${listing}")
  string(REPLACE "\n" ";" lines "${listing}")
  set(missing)
  foreach(line IN LISTS lines)
    # dumpbin lists imports and delay-load imports four spaces deep, the format CMake itself reads.
    if(NOT line MATCHES "^    ([^ ].*\\.[Dd][Ll][Ll])$")
      continue()
    endif()
    set(import "${CMAKE_MATCH_1}")
    string(TOLOWER "${import}" name)
    list(FIND system "${name}" listed)
    if(name MATCHES "^(api|ext)-ms-" OR listed GREATER -1)
      continue()
    endif()
    if(NOT EXISTS "${owner}/${import}" AND NOT EXISTS "${CMAKE_INSTALL_PREFIX}/${import}"
        AND NOT EXISTS "${CMAKE_INSTALL_PREFIX}/bin/${import}")
      list(APPEND missing "${import}")
    endif()
  endforeach()
  if(missing)
    message(FATAL_ERROR "Unpackaged inference imports: ${binary}: ${missing}")
  endif()
endforeach()
file(GLOB runtimes "${CMAKE_INSTALL_PREFIX}/bin/*140*.dll")
if(NOT runtimes)
  message(FATAL_ERROR "The licensed MSVC runtime closure is missing")
endif()
foreach(path IN LISTS runtimes)
  # A pwsh parent (the Actions default shell) leaves its PowerShell 7 module directories in
  # PSModulePath; Windows PowerShell 5.1 would autoload that incompatible Security module, so it
  # rebuilds its own path instead (PowerShell/PowerShell#27774).
  execute_process(COMMAND "@CMAKE_COMMAND@" -E env --unset=PSModulePath "KNOVUM_SIGNATURE_VERIFY_PATH=${path}"
    powershell.exe -NoProfile -NonInteractive -Command
    "$ErrorActionPreference='Stop'; $s=Get-AuthenticodeSignature -LiteralPath $env:KNOVUM_SIGNATURE_VERIFY_PATH; if($s.Status -ne 'Valid' -or $s.SignerCertificate.Subject -notmatch 'O=Microsoft Corporation'){throw 'Invalid Microsoft runtime publisher'}"
    COMMAND_ERROR_IS_FATAL ANY)
endforeach()
