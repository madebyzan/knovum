set(ENV{VSLANG} 1033)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_DUMPBIN@")
if(NOT CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND)
  find_program(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND NAMES dumpbin)
endif()
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/../../../build_support/windows-system-libraries.json" allowed)
# Windows owns the closure behind its own libraries. Resolving into System32 walks OS-internal and
# delay-loaded imports that differ between Windows editions, so allowed system libraries stop
# resolution by name and every other import must resolve inside the package.
set(system "^api-ms-.*" "^ext-ms-.*")
string(JSON count LENGTH "${allowed}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${allowed}" ${index})
  string(REPLACE "." "\\." name "${name}")
  list(APPEND system "^${name}$")
endforeach()
file(GLOB_RECURSE libraries "${CMAKE_INSTALL_PREFIX}/*.dll" "${CMAKE_INSTALL_PREFIX}/*.exe")
foreach(library IN LISTS libraries)
  get_filename_component(owner "${library}" DIRECTORY)
  if(library MATCHES "\\.exe$")
    set(kind EXECUTABLES)
  else()
    set(kind LIBRARIES)
  endif()
  file(GET_RUNTIME_DEPENDENCIES ${kind} "${library}"
    DIRECTORIES "${owner}" "${CMAKE_INSTALL_PREFIX}/bin" "${CMAKE_INSTALL_PREFIX}"
    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR missing
    PRE_EXCLUDE_REGEXES ${system})
  foreach(path IN LISTS resolved)
    cmake_path(IS_PREFIX CMAKE_INSTALL_PREFIX "${path}" NORMALIZE packaged)
    if(NOT packaged)
      message(FATAL_ERROR "Inference import is outside its packaged/system closure: ${library}: ${path}")
    endif()
  endforeach()
  if(missing)
    message(FATAL_ERROR "Unpackaged inference imports: ${library}: ${missing}")
  endif()
endforeach()
file(GLOB runtimes "${CMAKE_INSTALL_PREFIX}/bin/*140*.dll")
if(NOT runtimes)
  message(FATAL_ERROR "The licensed MSVC runtime closure is missing")
endif()
foreach(path IN LISTS runtimes)
  execute_process(COMMAND "@CMAKE_COMMAND@" -E env "KNOVUM_SIGNATURE_VERIFY_PATH=${path}" powershell.exe -NoProfile -NonInteractive -Command
    "$ErrorActionPreference='Stop'; $s=Get-AuthenticodeSignature -LiteralPath $env:KNOVUM_SIGNATURE_VERIFY_PATH; if($s.Status -ne 'Valid' -or $s.SignerCertificate.Subject -notmatch 'O=Microsoft Corporation'){throw 'Invalid Microsoft runtime publisher'}"
    COMMAND_ERROR_IS_FATAL ANY)
endforeach()
