# The bounded, regular install tree has already passed relocation and signing.
file(GLOB_RECURSE paths LIST_DIRECTORIES FALSE RELATIVE "${ROOT}" "${ROOT}/*")
list(SORT paths)
set(files "[]")
set(index 0)
foreach(path IN LISTS paths)
  file(SIZE "${ROOT}/${path}" size)
  file(SHA256 "${ROOT}/${path}" digest)
  string(REPLACE "\\" "\\\\" escaped "${path}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(JSON entry SET "{}" path "\"${escaped}\"")
  string(JSON entry SET "${entry}" size "${size}")
  string(JSON entry SET "${entry}" sha256 "\"${digest}\"")
  string(JSON files SET "${files}" ${index} "${entry}")
  math(EXPR index "${index}+1")
endforeach()
if(TARGET_PLATFORM STREQUAL "windows-x64")
  set(onnx onnxruntime.dll)
else()
  set(onnx libonnxruntime.1.22.1.dylib)
endif()
string(JSON manifest SET "{}" schemaVersion 1)
string(JSON manifest SET "${manifest}" target "\"${TARGET_PLATFORM}\"")
string(JSON manifest SET "${manifest}" onnxRuntime "\"${onnx}\"")
string(JSON manifest SET "${manifest}" files "${files}")
file(WRITE "${ROOT}/inference-runtime-manifest.json" "${manifest}")
