# Supplier archives are immutable inputs. CMake owns download caching and integrity.
function(knovum_record name)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/${name}-source.json" contents)
  set(${name}_record "${contents}" PARENT_SCOPE)
endfunction()
function(knovum_download record output)
  string(JSON url GET "${record}" url)
  string(JSON digest GET "${record}" sha256)
  file(DOWNLOAD "${url}" "${output}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON STATUS result)
  list(GET result 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Supplier download failed: ${result}")
  endif()
endfunction()
function(knovum_archive name record)
  string(JSON url GET "${record}" source url)
  string(JSON digest GET "${record}" source sha256)
  set(${name}_url "${url}" PARENT_SCOPE)
  set(${name}_hash "SHA256=${digest}" PARENT_SCOPE)
endfunction()
foreach(name onnx audio sherpa whisper windows)
  knovum_record(${name})
endforeach()
