{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceWireSchemas",
  "type": "object",
  "properties": {
    "diagnostic": {
      "$ref": "#/$defs/RuntimeDiagnostic"
    },
    "initialize_params": {
      "$ref": "#/$defs/RuntimeInitializeParams"
    },
    "initialize_result": {
      "$ref": "#/$defs/RuntimeSession"
    },
    "health_params": {
      "$ref": "#/$defs/RuntimeHealthParams"
    },
    "health_result": {
      "$ref": "#/$defs/RuntimeHealthObservation"
    },
    "cancel_params": {
      "$ref": "#/$defs/RuntimeCancelParams"
    },
    "cancel_result": {
      "$ref": "#/$defs/RuntimeCancellationAcknowledgement"
    },
    "ack_chunk_params": {
      "$ref": "#/$defs/RuntimeAckChunkParams"
    },
    "shutdown_params": {
      "$ref": "#/$defs/RuntimeShutdownParams"
    },
    "shutdown_result": {
      "$ref": "#/$defs/RuntimeShutdownAcknowledgement"
    },
    "embedding_params": {
      "$ref": "#/$defs/EmbeddingEncodeParams"
    },
    "embedding_result": {
      "$ref": "#/$defs/EmbeddingEncoding"
    },
    "image_compute_params": {
      "$ref": "#/$defs/ImageComputeParams"
    },
    "image_compute_output": {
      "$ref": "#/$defs/ImageComputationOutput"
    },
    "image_segment_params": {
      "$ref": "#/$defs/ImageSegmentParams"
    },
    "image_segment_result": {
      "$ref": "#/$defs/ImageSegmentation"
    },
    "speech_transcribe_params": {
      "$ref": "#/$defs/SpeechTranscribeParams"
    },
    "speech_transcribe_result": {
      "$ref": "#/$defs/SpeechTranscription"
    },
    "speech_transcript_artifact": {
      "$ref": "#/$defs/SpeechTranscriptArtifact"
    },
    "speech_progress_event": {
      "$ref": "#/$defs/SpeechProgressEvent"
    },
    "speech_progress_event_type": {
      "$ref": "#/$defs/SpeechProgressEventType"
    },
    "speech_align_params": {
      "$ref": "#/$defs/SpeechAlignParams"
    },
    "speech_align_result": {
      "$ref": "#/$defs/SpeechAlignment"
    },
    "speech_diarize_params": {
      "$ref": "#/$defs/SpeechDiarizeParams"
    },
    "speech_diarize_result": {
      "$ref": "#/$defs/SpeechDiarization"
    },
    "speech_synthesize_params": {
      "$ref": "#/$defs/SpeechSynthesizeParams"
    },
    "speech_synthesis_chunk_event": {
      "$ref": "#/$defs/SpeechSynthesisChunkEvent"
    },
    "speech_synthesis_chunk_granularity": {
      "$ref": "#/$defs/SpeechSynthesisChunkGranularity"
    },
    "speech_synthesize_result": {
      "$ref": "#/$defs/SpeechSynthesis"
    },
    "speech_separate_params": {
      "$ref": "#/$defs/SpeechSeparateParams"
    },
    "speech_separate_result": {
      "$ref": "#/$defs/SpeechSeparation"
    }
  },
  "required": [
    "diagnostic",
    "initialize_params",
    "initialize_result",
    "health_params",
    "health_result",
    "cancel_params",
    "cancel_result",
    "ack_chunk_params",
    "shutdown_params",
    "shutdown_result",
    "embedding_params",
    "embedding_result",
    "image_compute_params",
    "image_compute_output",
    "image_segment_params",
    "image_segment_result",
    "speech_transcribe_params",
    "speech_transcribe_result",
    "speech_transcript_artifact",
    "speech_progress_event",
    "speech_progress_event_type",
    "speech_align_params",
    "speech_align_result",
    "speech_diarize_params",
    "speech_diarize_result",
    "speech_synthesize_params",
    "speech_synthesis_chunk_event",
    "speech_synthesis_chunk_granularity",
    "speech_synthesize_result",
    "speech_separate_params",
    "speech_separate_result"
  ],
  "$defs": {
    "RuntimeDiagnostic": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/RuntimeDiagnosticEvent"
        },
        "code": {
          "$ref": "#/$defs/RuntimeDiagnosticCode"
        },
        "method": {
          "$ref": "#/$defs/RuntimeDiagnosticMethod"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "exceptionType": {
          "type": "string",
          "maxLength": 128
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeDiagnosticFrame"
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "code",
        "method",
        "exceptionType",
        "frames"
      ]
    },
    "RuntimeDiagnosticEvent": {
      "type": "string",
      "enum": [
        "requestFailed"
      ]
    },
    "RuntimeDiagnosticCode": {
      "type": "string",
      "enum": [
        "invalid_output",
        "runtime_mismatch",
        "resource_exhausted"
      ]
    },
    "RuntimeDiagnosticMethod": {
      "type": "string",
      "enum": [
        "runtime.initialize",
        "runtime.health",
        "runtime.cancel",
        "runtime.ackChunk",
        "runtime.shutdown",
        "embedding.encode",
        "image.segment",
        "speech.transcribe",
        "speech.align",
        "speech.diarize",
        "speech.synthesize",
        "speech.separate",
        "unknown"
      ]
    },
    "RuntimeDiagnosticFrame": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 128
        },
        "function": {
          "type": "string",
          "maxLength": 128
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "function",
        "line"
      ]
    },
    "RuntimeInitializeParams": {
      "type": "object",
      "properties": {
        "runtimeManifestPath": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runtimeDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/RuntimeCapability"
        },
        "capabilitySpecId": {
          "type": "string"
        },
        "deviceProfile": {
          "$ref": "#/$defs/RuntimeDeviceProfile"
        },
        "workDirectory": {
          "type": "string"
        },
        "modelPaths": {
          "$ref": "#/$defs/RuntimeModelPaths"
        }
      },
      "additionalProperties": false,
      "required": [
        "runtimeManifestPath",
        "protocolVersion",
        "runtimeDigest",
        "sessionId",
        "capability",
        "capabilitySpecId",
        "deviceProfile",
        "workDirectory",
        "modelPaths"
      ]
    },
    "RuntimeCapability": {
      "type": "string",
      "enum": [
        "embedding",
        "speech_transcription",
        "speech_alignment",
        "speech_diarization",
        "speech_synthesis",
        "speech_separation",
        "image_segmentation",
        "image_upscaling",
        "image_inpainting",
        "image_selection",
        "image_depth"
      ]
    },
    "RuntimeDeviceProfile": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "executionProfileId": {
          "type": "string"
        },
        "cpuThreads": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "executionProfileId",
        "cpuThreads"
      ]
    },
    "RuntimeModelPaths": {
      "type": "object",
      "properties": {
        "embedding": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechTranscription": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechAlignment": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechDiarization": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechSynthesis": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechSeparation": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageSegmentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageProcessing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRuntimeModelPath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ImageRuntimeModelPath": {
      "type": "object",
      "properties": {
        "variant": {
          "$ref": "#/$defs/ImageModelVariant"
        },
        "directory": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "variant",
        "directory"
      ]
    },
    "ImageModelVariant": {
      "type": "string",
      "enum": [
        "realEsrganGeneralX4v3",
        "realEsrganX4plus",
        "migan",
        "efficientSamTi",
        "efficientSamS",
        "depthAnythingV2SmallUint8",
        "depthAnythingV2Small"
      ]
    },
    "RuntimeSession": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runtimeDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/RuntimeCapability"
        },
        "capabilitySpecId": {
          "type": "string"
        },
        "deviceProfile": {
          "$ref": "#/$defs/RuntimeDeviceProfile"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/RuntimeLimits"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "runtimeDigest",
        "sessionId",
        "capability",
        "capabilitySpecId",
        "deviceProfile",
        "capabilities",
        "limits"
      ]
    },
    "RuntimeLimits": {
      "type": "object",
      "properties": {
        "maxMessageBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxEmbeddingTexts": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "maxEmbeddingTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxUnconsumedChunkFiles": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "maxUnconsumedChunkBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxMessageBytes",
        "maxEmbeddingTexts",
        "maxEmbeddingTokens",
        "maxUnconsumedChunkFiles",
        "maxUnconsumedChunkBytes"
      ]
    },
    "RuntimeHealthParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId"
      ]
    },
    "RuntimeHealthObservation": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "currentRequestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "residentBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId",
        "residentBytes"
      ]
    },
    "RuntimeCancelParams": {
      "type": "object",
      "properties": {
        "targetRequestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "targetRequestId",
        "attemptEpoch"
      ]
    },
    "RuntimeCancellationAcknowledgement": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "RuntimeAckChunkParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "consumedBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "seq",
        "consumedBytes"
      ]
    },
    "RuntimeShutdownParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId"
      ]
    },
    "RuntimeShutdownAcknowledgement": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "EmbeddingEncodeParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/EmbeddingRole"
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embeddingSpecId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "role",
        "texts",
        "embeddingSpecId"
      ]
    },
    "EmbeddingRole": {
      "type": "string",
      "enum": [
        "query",
        "document"
      ]
    },
    "EmbeddingEncoding": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "embeddingSpecId": {
          "type": "string"
        },
        "vectors": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            }
          }
        },
        "dimensions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "embeddingSpecId",
        "vectors",
        "dimensions",
        "inputTokens"
      ]
    },
    "ImageComputeParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tensorRef": {
          "$ref": "#/$defs/TensorFileReference"
        },
        "computation": {
          "$ref": "#/$defs/ImageComputation"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "tensorRef",
        "computation"
      ]
    },
    "TensorFileReference": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "dataType": {
          "$ref": "#/$defs/TensorDataType"
        }
      },
      "additionalProperties": false,
      "required": [
        "fileName",
        "byteLength",
        "sha256",
        "shape",
        "dataType"
      ]
    },
    "TensorDataType": {
      "type": "string",
      "enum": [
        "float32_little_endian",
        "uint8"
      ]
    },
    "ImageComputation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "upscale"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "maskRef": {
              "$ref": "#/$defs/TensorFileReference"
            },
            "kind": {
              "type": "string",
              "const": "inpaint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "maskRef"
          ]
        },
        {
          "type": "object",
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ImageSelectionPoint"
              }
            },
            "boxRect": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ImageSelectionRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "select"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "depth"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ImageSelectionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "foreground": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "foreground"
      ]
    },
    "ImageSelectionRect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "width": {
          "type": "number",
          "format": "float"
        },
        "height": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ImageComputationOutput": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "modelSpecId": {
          "type": "string"
        },
        "tensorRef": {
          "$ref": "#/$defs/TensorFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "modelSpecId",
        "tensorRef"
      ]
    },
    "ImageSegmentParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tensorRef": {
          "$ref": "#/$defs/TensorFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "tensorRef"
      ]
    },
    "ImageSegmentation": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "modelSpecId": {
          "type": "string"
        },
        "maskRef": {
          "$ref": "#/$defs/TensorFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "modelSpecId",
        "maskRef"
      ]
    },
    "SpeechTranscribeParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "audioRef": {
