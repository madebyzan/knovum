{
  "$defs": {
    "ExecutionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": ["id", "parameters"],
      "title": "ExecutionConfiguration",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": ["path", "sha256"],
      "title": "HashedFile",
      "type": "object"
    },
    "ImageLimits": {
      "additionalProperties": false,
      "properties": {
        "maximumLoadSeconds": {
          "exclusiveMinimum": 0,
          "title": "Maximumloadseconds",
          "type": "number"
        },
        "maximumWarmSeconds": {
          "exclusiveMinimum": 0,
          "title": "Maximumwarmseconds",
          "type": "number"
        },
        "maximumPeakRssBytes": {
          "exclusiveMinimum": 0,
          "title": "Maximumpeakrssbytes",
          "type": "integer"
        },
        "maximumCancelSeconds": {
          "exclusiveMinimum": 0,
          "title": "Maximumcancelseconds",
          "type": "number"
        }
      },
      "required": ["maximumLoadSeconds", "maximumWarmSeconds", "maximumPeakRssBytes", "maximumCancelSeconds"],
      "title": "ImageLimits",
      "type": "object"
    },
    "ImageProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "capability": {
          "enum": ["upscale", "repair", "selection", "depth"],
          "title": "Capability",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "config": {
          "$ref": "#/$defs/ExecutionConfiguration"
        },
        "sampleIds": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Sampleids",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ImageLimits"
        }
      },
      "required": ["id", "capability", "model", "config", "sampleIds", "limits"],
      "title": "ImageProfile",
      "type": "object"
    },
    "ImageSample": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/HashedFile"
        },
        "renderedRgb": {
          "$ref": "#/$defs/HashedFile"
        },
        "license": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "License",
          "type": "string"
        },
        "sourceUrl": {
          "pattern": "^https://",
          "title": "Sourceurl",
          "type": "string"
        },
        "coverage": {
          "items": {
            "enum": [
              "hair",
              "product_edges",
              "transparent",
              "text",
              "anime",
              "repeated_texture",
              "large_selection",
              "thin",
              "exif"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Coverage",
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Height",
          "type": "integer"
        },
        "selectionMask": {
          "$ref": "#/$defs/HashedFile"
        }
      },
      "required": [
        "id",
        "original",
        "renderedRgb",
        "license",
        "sourceUrl",
        "coverage",
        "width",
        "height",
        "selectionMask"
      ],
      "title": "ImageSample",
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "specId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Specid",
          "type": "string"
        },
        "identityDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identitydigest",
          "type": "string"
        }
      },
      "required": ["specId", "identityDigest"],
      "title": "ModelIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "corpusId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Corpusid",
      "type": "string"
    },
    "corpusVersion": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Corpusversion",
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/ImageSample"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ImageProfile"
      },
      "minItems": 1,
      "title": "Profiles",
      "type": "array"
    }
  },
  "required": ["schemaVersion", "corpusId", "corpusVersion", "samples", "profiles"],
  "title": "ImageCorpus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
