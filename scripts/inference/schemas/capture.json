{
  "$defs": {
    "AlignmentEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "candidateOutput": {
          "$ref": "#/$defs/HashedFile"
        }
      },
      "required": ["status", "candidateOutput"],
      "title": "AlignmentEvidence",
      "type": "object"
    },
    "Blinding": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "$ref": "#/$defs/HashedFile"
        },
        "revealedAfterReviewsAt": {
          "format": "date-time",
          "title": "Revealedafterreviewsat",
          "type": "string"
        }
      },
      "required": ["assignment", "revealedAfterReviewsAt"],
      "title": "Blinding",
      "type": "object"
    },
    "CapabilityEvidence": {
      "additionalProperties": false,
      "properties": {
        "embedding": {
          "oneOf": [
            {
              "$ref": "#/$defs/EmbeddingEvidence"
            },
            {
              "$ref": "#/$defs/Unavailable"
            }
          ],
          "title": "Embedding"
        },
        "asr": {
          "oneOf": [
            {
              "$ref": "#/$defs/TranscriptionEvidence"
            },
            {
              "$ref": "#/$defs/Unavailable"
            }
          ],
          "title": "Asr"
        },
        "alignment": {
          "oneOf": [
            {
              "$ref": "#/$defs/AlignmentEvidence"
            },
            {
              "$ref": "#/$defs/Unavailable"
            }
          ],
          "title": "Alignment"
        },
        "tts": {
          "oneOf": [
            {
              "$ref": "#/$defs/SynthesisEvidence"
            },
            {
              "$ref": "#/$defs/Unavailable"
            }
          ],
          "title": "Tts"
        }
      },
      "required": ["embedding", "asr", "alignment", "tts"],
      "title": "CapabilityEvidence",
      "type": "object"
    },
    "CapabilityRecords_ExecutionConfiguration_": {
      "additionalProperties": false,
      "properties": {
        "embedding": {
          "$ref": "#/$defs/ExecutionConfiguration"
        },
        "asr": {
          "$ref": "#/$defs/ExecutionConfiguration"
        },
        "alignment": {
          "$ref": "#/$defs/ExecutionConfiguration"
        },
        "tts": {
          "$ref": "#/$defs/ExecutionConfiguration"
        }
      },
      "required": ["embedding", "asr", "alignment", "tts"],
      "title": "CapabilityRecords[ExecutionConfiguration]",
      "type": "object"
    },
    "CapabilityRecords_ModelIdentity_": {
      "additionalProperties": false,
      "properties": {
        "embedding": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "asr": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "alignment": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "tts": {
          "$ref": "#/$defs/ModelIdentity"
        }
      },
      "required": ["embedding", "asr", "alignment", "tts"],
      "title": "CapabilityRecords[ModelIdentity]",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Manufacturer",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model",
          "type": "string"
        },
        "cpu": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cpu",
          "type": "string"
        },
        "physicalCores": {
          "exclusiveMinimum": 0,
          "title": "Physicalcores",
          "type": "integer"
        },
        "memoryBytes": {
          "exclusiveMinimum": 0,
          "title": "Memorybytes",
          "type": "integer"
        },
        "os": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Os",
          "type": "string"
        },
        "osVersion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Osversion",
          "type": "string"
        },
        "powerMode": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Powermode",
          "type": "string"
        },
        "accelerator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Accelerator",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Driver"
        }
      },
      "required": [
        "manufacturer",
        "model",
        "cpu",
        "physicalCores",
        "memoryBytes",
        "os",
        "osVersion",
        "powerMode",
        "accelerator",
        "driver"
      ],
      "title": "Device",
      "type": "object"
    },
    "EmbeddingEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "comparisonMode": {
          "enum": ["cpu_float32", "release_profile"],
          "title": "Comparisonmode",
          "type": "string"
        },
        "referenceOutput": {
          "$ref": "#/$defs/HashedFile"
        },
        "candidateOutput": {
          "$ref": "#/$defs/HashedFile"
        }
      },
      "required": ["status", "comparisonMode", "referenceOutput", "candidateOutput"],
      "title": "EmbeddingEvidence",
      "type": "object"
    },
    "ExecutionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": ["id", "parameters"],
      "title": "ExecutionConfiguration",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": ["path", "sha256"],
      "title": "HashedFile",
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "specId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Specid",
          "type": "string"
        },
        "identityDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identitydigest",
          "type": "string"
        }
      },
      "required": ["specId", "identityDigest"],
      "title": "ModelIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "appVersion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Appversion",
          "type": "string"
        },
        "appCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Appcommit",
          "type": "string"
        },
        "workerDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workerdigest",
          "type": "string"
        },
        "runtimeVersion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Runtimeversion",
          "type": "string"
        },
        "runtimeDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtimedigest",
          "type": "string"
        },
        "target": {
          "enum": ["macos-arm64", "macos-x64", "windows-x64"],
          "title": "Target",
          "type": "string"
        },
        "models": {
          "$ref": "#/$defs/CapabilityRecords_ModelIdentity_"
        },
        "configs": {
          "$ref": "#/$defs/CapabilityRecords_ExecutionConfiguration_"
        },
        "corpusSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpussha256",
          "type": "string"
        },
        "device": {
          "$ref": "#/$defs/Device"
        }
      },
      "required": [
        "appVersion",
        "appCommit",
        "workerDigest",
        "runtimeVersion",
        "runtimeDigest",
        "target",
        "models",
        "configs",
        "corpusSha256",
        "device"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SynthesisEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "candidateOutput": {
          "$ref": "#/$defs/HashedFile"
        },
        "blinding": {
          "$ref": "#/$defs/Blinding"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/VoiceReview"
          },
          "title": "Reviews",
          "type": "array"
        }
      },
      "required": ["status", "candidateOutput", "blinding", "reviews"],
      "title": "SynthesisEvidence",
      "type": "object"
    },
    "TranscriptionEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "baselineOutput": {
          "$ref": "#/$defs/HashedFile"
        },
        "candidateOutput": {
          "$ref": "#/$defs/HashedFile"
        }
      },
      "required": ["status", "baselineOutput", "candidateOutput"],
      "title": "TranscriptionEvidence",
      "type": "object"
    },
    "Unavailable": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["status", "reason"],
      "title": "Unavailable",
      "type": "object"
    },
    "VoiceReview": {
      "additionalProperties": false,
      "properties": {
        "sampleId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sampleid",
          "type": "string"
        },
        "raterId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Raterid",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/VoiceScores"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "reviewedAt": {
          "format": "date-time",
          "title": "Reviewedat",
          "type": "string"
        }
      },
      "required": ["sampleId", "raterId", "scores", "notes", "reviewedAt"],
      "title": "VoiceReview",
      "type": "object"
    },
    "VoiceScores": {
      "additionalProperties": false,
      "properties": {
        "pronunciation": {
          "maximum": 5,
          "minimum": 1,
          "title": "Pronunciation",
          "type": "number"
        },
        "naturalness": {
          "maximum": 5,
          "minimum": 1,
          "title": "Naturalness",
          "type": "number"
        },
        "voiceConsistency": {
          "maximum": 5,
          "minimum": 1,
          "title": "Voiceconsistency",
          "type": "number"
        },
        "referenceSimilarity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Referencesimilarity",
          "type": "number"
        },
        "emotionControl": {
          "maximum": 5,
          "minimum": 1,
          "title": "Emotioncontrol",
          "type": "number"
        }
      },
      "required": [
        "pronunciation",
        "naturalness",
        "voiceConsistency",
        "referenceSimilarity",
        "emotionControl"
      ],
      "title": "VoiceScores",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "runId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Runid",
      "type": "string"
    },
    "capturedAt": {
      "format": "date-time",
      "title": "Capturedat",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilityEvidence"
    }
  },
  "required": ["schemaVersion", "runId", "capturedAt", "provenance", "capabilities"],
  "title": "CaptureManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
