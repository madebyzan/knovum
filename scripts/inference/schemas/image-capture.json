{
  "$defs": {
    "Device": {
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Manufacturer",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model",
          "type": "string"
        },
        "cpu": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cpu",
          "type": "string"
        },
        "physicalCores": {
          "exclusiveMinimum": 0,
          "title": "Physicalcores",
          "type": "integer"
        },
        "memoryBytes": {
          "exclusiveMinimum": 0,
          "title": "Memorybytes",
          "type": "integer"
        },
        "os": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Os",
          "type": "string"
        },
        "osVersion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Osversion",
          "type": "string"
        },
        "powerMode": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Powermode",
          "type": "string"
        },
        "accelerator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Accelerator",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Driver"
        }
      },
      "required": [
        "manufacturer",
        "model",
        "cpu",
        "physicalCores",
        "memoryBytes",
        "os",
        "osVersion",
        "powerMode",
        "accelerator",
        "driver"
      ],
      "title": "Device",
      "type": "object"
    },
    "ExecutionSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["bundled_worker", "official_python_reference", "product_baseline"],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method",
          "type": "string"
        },
        "workerDigest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workerdigest"
        },
        "runtimeDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtimedigest",
          "type": "string"
        },
        "modelSpecId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Modelspecid",
          "type": "string"
        },
        "configId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Configid",
          "type": "string"
        },
        "invocations": {
          "items": {
            "$ref": "#/$defs/Invocation"
          },
          "minItems": 1,
          "title": "Invocations",
          "type": "array"
        }
      },
      "required": ["kind", "method", "runtimeDigest", "modelSpecId", "configId", "invocations"],
      "title": "ExecutionSource",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": ["path", "sha256"],
      "title": "HashedFile",
      "type": "object"
    },
    "ImageArtifact": {
      "additionalProperties": false,
      "properties": {
        "sampleId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sampleid",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/HashedFile"
        },
        "warmSeconds": {
          "minimum": 0,
          "title": "Warmseconds",
          "type": "number"
        },
        "cancelSeconds": {
          "minimum": 0,
          "title": "Cancelseconds",
          "type": "number"
        },
        "qualityPassed": {
          "title": "Qualitypassed",
          "type": "boolean"
        },
        "reviewer": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reviewer",
          "type": "string"
        },
        "reviewNotes": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reviewnotes",
          "type": "string"
        }
      },
      "required": [
        "sampleId",
        "output",
        "warmSeconds",
        "cancelSeconds",
        "qualityPassed",
        "reviewer",
        "reviewNotes"
      ],
      "title": "ImageArtifact",
      "type": "object"
    },
    "ImageModelCapture": {
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Profileid",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ExecutionSource"
        },
        "loadSeconds": {
          "minimum": 0,
          "title": "Loadseconds",
          "type": "number"
        },
        "peakRssBytes": {
          "exclusiveMinimum": 0,
          "title": "Peakrssbytes",
          "type": "integer"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ImageArtifact"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": ["profileId", "source", "loadSeconds", "peakRssBytes", "artifacts"],
      "title": "ImageModelCapture",
      "type": "object"
    },
    "Invocation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requestid",
          "type": "string"
        },
        "attemptEpoch": {
          "minimum": 0,
          "title": "Attemptepoch",
          "type": "integer"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "title": "Finishedat",
          "type": "string"
        }
      },
      "required": ["requestId", "attemptEpoch", "startedAt", "finishedAt"],
      "title": "Invocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "runId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Runid",
      "type": "string"
    },
    "capturedAt": {
      "format": "date-time",
      "title": "Capturedat",
      "type": "string"
    },
    "appCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Appcommit",
      "type": "string"
    },
    "corpusSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpussha256",
      "type": "string"
    },
    "workerDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workerdigest",
      "type": "string"
    },
    "runtimeDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtimedigest",
      "type": "string"
    },
    "target": {
      "enum": ["macos-arm64", "macos-x64", "windows-x64"],
      "title": "Target",
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/Device"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ImageModelCapture"
      },
      "title": "Models",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "capturedAt",
    "appCommit",
    "corpusSha256",
    "workerDigest",
    "runtimeDigest",
    "target",
    "device",
    "models"
  ],
  "title": "ImageCapture",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
