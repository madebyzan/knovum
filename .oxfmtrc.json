{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles/app.css"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "src/shared/contracts/generated/**",
    "python/schemas/runtime.schema.json",
    "src/features/spaces/contracts/generated/**"
  ]
}
