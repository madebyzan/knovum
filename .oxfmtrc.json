{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles/app.css"
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/resources/native-runtime/**",
    "src-tauri/crates/inference-contracts/inference.schema.json",
    "node_modules/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "src-tauri/resources/bundled-runtime/*/**",
    "src-tauri/resources/python-worker/**",
    "src-tauri/resources/runtime-artifacts/**",
    ".runtime-development/**",
    "runtime-artifacts/**",
    "src/shared/contracts/generated/**",
    "python/schemas/*.schema.json",
    "src/features/dictation/contracts/generated/**",
    "src/features/spaces/contracts/generated/**",
    "src/features/settings/contracts/generated/**"
  ]
}
