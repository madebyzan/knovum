{
  "name": "knovum",
  "version": "0.0.1",
  "private": true,
  "author": "Zan",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:dev": "node scripts/desktop/tauri.mjs dev",
    "package": "node scripts/desktop/tauri.mjs build",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run",
    "check": "pnpm check:scripts && pnpm check:web && pnpm check:rust && pnpm check:python",
    "check:web": "pnpm typecheck && pnpm lint && depcruise --config .dependency-cruiser.cjs src && pnpm test && knip && jscpd src --min-lines 6 --min-tokens 80 --threshold 1 && pnpm format --check",
    "check:rust": "node scripts/checks/capabilities.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml --workspace && jscpd src-tauri/src src-tauri/crates --min-lines 6 --min-tokens 80 --threshold 1",
    "check:python": "node scripts/checks/python.mjs",
    "security:web": "pnpm --registry=https://registry.npmjs.org audit --prod --audit-level high && pnpm --registry=https://registry.npmjs.org audit signatures",
    "e2e:build": "vite build --mode e2e && tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "pnpm e2e:build && wdio run wdio.conf.ts",
    "contracts:generate": "node scripts/contracts.mjs",
    "runtime:build": "node scripts/runtime/producer.mjs",
    "runtime:prepare": "node scripts/runtime/development.mjs",
    "runtime:provision": "node scripts/runtime/provision.mjs",
    "check:scripts": "node --test \"scripts/**/__tests__/*.test.mjs\"",
    "security:python": "uv audit --project python --locked && uv audit --project python/runtimes/agent --locked",
    "contracts:check": "node scripts/checks/contracts.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.52.0",
    "@mozilla/readability": "0.6.0",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-file-handler": "3.31.4",
    "@tiptap/extension-find-and-replace": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "es-toolkit": "^1.52.0",
    "fast-fuzzy": "^1.12.0",
    "konva": "10.7.1",
    "markdown-it": "^15.0.2",
    "p-limit": "7.3.3",
    "pathe": "^2.0.3",
    "pinia": "^4.0.3",
    "rbush": "4.0.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tauri-plugin-clipboard-api": "^2.1.11",
    "tinykeys": "^4.0.1",
    "ufo": "^1.6.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-konva": "4.0.1",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/rbush": "4.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "dependency-cruiser": "^18.5.0",
    "happy-dom": "^20.14.5",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.17.0"
}
