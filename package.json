{
  "name": "knovum",
  "version": "0.0.1",
  "private": true,
  "author": "Zan",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node tools/run-tauri.mjs",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "architecture": "pnpm check:source-layout && depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip",
    "duplicates": "jscpd src src-tauri/src --min-lines 6 --min-tokens 80 --threshold 1",
    "security:web": "pnpm audit --prod --audit-level high && pnpm audit signatures",
    "check:web": "pnpm typecheck && pnpm typecheck:e2e && pnpm lint && pnpm architecture && pnpm test && pnpm deadcode && pnpm duplicates && pnpm format:check",
    "check:rust": "pnpm check:source-layout && pnpm check:capabilities && pnpm check:rust-boundaries && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm check:web && pnpm check:rust",
    "build:e2e": "vite build --mode e2e",
    "e2e:build": "pnpm build:e2e && tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "pnpm e2e:build && wdio run wdio.conf.ts",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "desktop:dev": "node tools/run-tauri.mjs dev",
    "desktop:build": "tauri build --no-bundle",
    "runtime:provision": "node tools/provision-bundled-runtime.mjs",
    "contracts:generate": "cargo test --manifest-path src-tauri/Cargo.toml --lib contract_codegen::tests::export_space_contracts -- --ignored --exact",
    "package": "node tools/package-desktop.mjs",
    "package:macos": "node tools/package-desktop.mjs --bundles app,dmg",
    "package:windows": "node tools/package-desktop.mjs --bundles nsis",
    "package:windows:msi": "node tools/package-desktop.mjs --bundles msi",
    "package:release": "node tools/package-desktop.mjs --release",
    "package:release:macos": "node tools/package-desktop.mjs --release --bundles app,dmg",
    "package:release:windows": "node tools/package-desktop.mjs --release --bundles nsis",
    "smoke:cutout:build": "pnpm build:e2e && tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "smoke:cutout": "pnpm smoke:cutout:build && wdio run wdio.release.conf.ts",
    "check:capabilities": "node tools/check-capability-policy.mjs",
    "check:rust-boundaries": "node tools/check-rust-boundaries.mjs",
    "check:source-layout": "node tools/check-source-layout.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.40.0",
    "@mozilla/readability": "0.6.0",
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-virtual": "^3.13.36",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tiptap/core": "3.31.1",
    "@tiptap/extension-file-handler": "3.31.1",
    "@tiptap/extension-find-and-replace": "3.31.1",
    "@tiptap/extension-highlight": "3.31.1",
    "@tiptap/extension-image": "3.31.1",
    "@tiptap/extension-list": "3.31.1",
    "@tiptap/extension-subscript": "3.31.1",
    "@tiptap/extension-superscript": "3.31.1",
    "@tiptap/extension-table": "3.31.1",
    "@tiptap/extension-text-align": "3.31.1",
    "@tiptap/extension-text-style": "3.31.1",
    "@tiptap/extension-typography": "3.31.1",
    "@tiptap/extensions": "3.31.1",
    "@tiptap/markdown": "3.31.1",
    "@tiptap/pm": "3.31.1",
    "@tiptap/starter-kit": "3.31.1",
    "@tiptap/vue-3": "3.31.1",
    "@vueuse/core": "^14.4.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "es-toolkit": "^1.52.0",
    "fast-fuzzy": "^1.12.0",
    "konva": "10.5.0",
    "markdown-it": "^15.0.1",
    "p-limit": "4.0.0",
    "pathe": "^2.0.3",
    "pinia": "^4.0.3",
    "rbush": "4.0.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tauri-plugin-clipboard-api": "^2.1.11",
    "tinykeys": "^4.0.0",
    "ufo": "^1.6.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-konva": "4.0.1",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "@types/rbush": "4.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@wdio/cli": "^9.31.5",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "dependency-cruiser": "^18.2.0",
    "happy-dom": "^20.14.0",
    "jscpd": "^5.1.2",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.17.0"
}
