    "health_params": {
      "$ref": "#/$defs/RuntimeHealthParams"
    },
    "health_result": {
      "$ref": "#/$defs/RuntimeHealthResult"
    },
    "cancel_params": {
      "$ref": "#/$defs/RuntimeCancelParams"
    },
    "cancel_result": {
      "$ref": "#/$defs/RuntimeCancelResult"
    },
    "ack_chunk_params": {
      "$ref": "#/$defs/RuntimeAckChunkParams"
    },
    "shutdown_params": {
      "$ref": "#/$defs/RuntimeShutdownParams"
    },
    "shutdown_result": {
      "$ref": "#/$defs/RuntimeShutdownResult"
    },
    "embedding_params": {
      "$ref": "#/$defs/EmbeddingEncodeParams"
    },
    "embedding_result": {
      "$ref": "#/$defs/EmbeddingEncodeResult"
    },
    "image_segment_params": {
      "$ref": "#/$defs/ImageSegmentParams"
    },
    "image_segment_result": {
      "$ref": "#/$defs/ImageSegmentResult"
    },
    "speech_transcribe_params": {
      "$ref": "#/$defs/SpeechTranscribeParams"
    },
    "speech_transcribe_result": {
      "$ref": "#/$defs/SpeechTranscribeResult"
    },
    "speech_transcript_artifact": {
      "$ref": "#/$defs/SpeechTranscriptArtifact"
    },
    "speech_progress_event": {
      "$ref": "#/$defs/SpeechProgressEvent"
    },
    "speech_progress_event_type": {
      "$ref": "#/$defs/SpeechProgressEventType"
    },
    "speech_align_params": {
      "$ref": "#/$defs/SpeechAlignParams"
    },
    "speech_align_result": {
      "$ref": "#/$defs/SpeechAlignResult"
    },
    "speech_diarize_params": {
      "$ref": "#/$defs/SpeechDiarizeParams"
    },
    "speech_diarize_result": {
      "$ref": "#/$defs/SpeechDiarizeResult"
    },
    "speech_synthesize_params": {
      "$ref": "#/$defs/SpeechSynthesizeParams"
    },
    "speech_synthesis_chunk_event": {
      "$ref": "#/$defs/SpeechSynthesisChunkEvent"
    },
    "speech_synthesis_chunk_granularity": {
      "$ref": "#/$defs/SpeechSynthesisChunkGranularity"
    },
    "speech_synthesize_result": {
      "$ref": "#/$defs/SpeechSynthesizeResult"
    },
    "speech_separate_params": {
      "$ref": "#/$defs/SpeechSeparateParams"
    },
    "speech_separate_result": {
      "$ref": "#/$defs/SpeechSeparateResult"
    }
  },
  "required": [
    "initialize_params",
    "initialize_result",
    "health_params",
    "health_result",
    "cancel_params",
    "cancel_result",
    "ack_chunk_params",
    "shutdown_params",
    "shutdown_result",
    "embedding_params",
    "embedding_result",
    "image_segment_params",
    "image_segment_result",
    "speech_transcribe_params",
    "speech_transcribe_result",
    "speech_transcript_artifact",
    "speech_progress_event",
    "speech_progress_event_type",
    "speech_align_params",
    "speech_align_result",
    "speech_diarize_params",
    "speech_diarize_result",
    "speech_synthesize_params",
    "speech_synthesis_chunk_event",
    "speech_synthesis_chunk_granularity",
    "speech_synthesize_result",
    "speech_separate_params",
    "speech_separate_result"
  ],
  "$defs": {
    "RuntimeInitializeParams": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runtimeDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/RuntimeCapability"
        },
        "capabilitySpecId": {
          "type": "string"
        },
        "deviceProfile": {
          "$ref": "#/$defs/RuntimeDeviceProfile"
        },
        "workDirectory": {
          "type": "string"
        },
        "modelPaths": {
          "$ref": "#/$defs/RuntimeModelPaths"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "runtimeDigest",
        "sessionId",
        "capability",
        "capabilitySpecId",
        "deviceProfile",
        "workDirectory",
        "modelPaths"
      ]
    },
    "RuntimeCapability": {
      "type": "string",
      "enum": [
        "embedding",
        "speech_transcription",
        "speech_alignment",
        "speech_diarization",
        "speech_synthesis",
        "speech_separation",
        "image_segmentation"
      ]
    },
    "RuntimeDeviceProfile": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "executionProfileId": {
          "type": "string"
        },
        "cpuThreads": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "executionProfileId",
        "cpuThreads"
      ]
    },
    "RuntimeModelPaths": {
      "type": "object",
      "properties": {
        "embedding": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechTranscription": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechAlignment": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechDiarization": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechSynthesis": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechSeparation": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageSegmentation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RuntimeInitializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runtimeDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/RuntimeCapability"
        },
        "capabilitySpecId": {
          "type": "string"
        },
        "deviceProfile": {
          "$ref": "#/$defs/RuntimeDeviceProfile"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/RuntimeLimits"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "runtimeDigest",
        "sessionId",
        "capability",
        "capabilitySpecId",
        "deviceProfile",
        "capabilities",
        "limits"
      ]
    },
    "RuntimeLimits": {
      "type": "object",
      "properties": {
        "maxMessageBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxEmbeddingTexts": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "maxEmbeddingTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxUnconsumedChunkFiles": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "maxUnconsumedChunkBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxMessageBytes",
        "maxEmbeddingTexts",
        "maxEmbeddingTokens",
        "maxUnconsumedChunkFiles",
        "maxUnconsumedChunkBytes"
      ]
    },
    "RuntimeHealthParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId"
      ]
    },
    "RuntimeHealthResult": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "currentRequestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "residentBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId",
        "residentBytes"
      ]
    },
    "RuntimeCancelParams": {
      "type": "object",
      "properties": {
        "targetRequestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "targetRequestId",
        "attemptEpoch"
      ]
    },
    "RuntimeCancelResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "RuntimeAckChunkParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "consumedBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "seq",
        "consumedBytes"
      ]
    },
    "RuntimeShutdownParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId"
      ]
    },
    "RuntimeShutdownResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "EmbeddingEncodeParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/EmbeddingRole"
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embeddingSpecId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "role",
        "texts",
        "embeddingSpecId"
      ]
    },
    "EmbeddingRole": {
      "type": "string",
      "enum": [
        "query",
        "document"
      ]
    },
    "EmbeddingEncodeResult": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "embeddingSpecId": {
          "type": "string"
        },
        "vectors": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            }
          }
        },
        "dimensions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "embeddingSpecId",
        "vectors",
        "dimensions",
        "inputTokens"
      ]
    },
    "ImageSegmentParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tensorRef": {
          "$ref": "#/$defs/TensorFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "tensorRef"
      ]
    },
    "TensorFileReference": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "dataType": {
          "$ref": "#/$defs/TensorDataType"
        }
      },
      "additionalProperties": false,
      "required": [
        "fileName",
        "byteLength",
        "sha256",
        "shape",
        "dataType"
      ]
    },
    "TensorDataType": {
      "type": "string",
      "enum": [
        "float32_little_endian"
      ]
    },
    "ImageSegmentResult": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "modelSpecId": {
          "type": "string"
        },
        "maskRef": {
          "$ref": "#/$defs/TensorFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "modelSpecId",
        "maskRef"
      ]
    },
    "SpeechTranscribeParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "audioRef": {
          "$ref": "#/$defs/AudioFileReference"
        },
        "profile": {
          "$ref": "#/$defs/AsrProfile"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "ownerKind",
        "ownerId",
        "attemptId",
        "attemptEpoch",
        "inputRevision",
        "modelSpecId",
        "deadlineMs",
        "audioRef",
        "profile"
      ]
    },
    "AudioFileReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "sampleRate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channels": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "sampleFormat": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "byteLength",
        "sha256",
        "sampleRate",
        "channels",
        "sampleFormat"
      ]
    },
    "AsrProfile": {
      "type": "object",
      "properties": {
        "engine": {
          "$ref": "#/$defs/AsrEngine"
        },
        "languagePolicy": {
          "$ref": "#/$defs/LanguagePolicy"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": "string"
        },
        "computeType": {
          "type": "string"
        },
        "beamSize": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "vadEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "languagePolicy",
        "device",
        "computeType",
        "beamSize",
        "vadEnabled"
      ]
    },
    "AsrEngine": {
      "type": "string",
      "enum": [
        "faster_whisper",
        "mlx_whisper"
      ]
    },
    "LanguagePolicy": {
      "type": "string",
      "enum": [
        "detect",
        "fixed"
      ]
    },
    "SpeechTranscribeResult": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "modelSpecId": {
          "type": "string"
        },
        "transcriptRef": {
          "$ref": "#/$defs/SpeechFileReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "modelSpecId",
        "transcriptRef"
      ]
    },
    "SpeechFileReference": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fileName",
        "mediaType",
        "byteLength",
        "sha256"
      ]
    },
    "SpeechTranscriptArtifact": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "speechDurationMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeechTranscriptSegment"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "language",
        "durationMs",
        "speechDurationMs",
        "segments"
      ]
    },
    "SpeechTranscriptSegment": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeechWordTiming"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs",
        "text",
        "words"
      ]
    },
    "SpeechWordTiming": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "startMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "startMs",
        "endMs"
      ]
    },
    "SpeechProgressEvent": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "eventType": {
          "$ref": "#/$defs/SpeechProgressEventType"
        },
        "stage": {
          "type": "string"
        },
        "progress": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "partial": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechTranscriptSegment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptEpoch",
        "seq",
        "eventType",
        "stage",
        "progress"
      ]
    },
    "SpeechProgressEventType": {
      "type": "string",
      "enum": [
        "progress",
        "partial_transcript"
      ]
    },
    "SpeechAlignParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inputRevision": {
          "type": "string"
        },
        "modelSpecId": {
          "type": "string"
        },
        "deadlineMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "audioRef": {
          "$ref": "#/$defs/AudioFileReference"
        },
        "textSegments": {
          "type": "array",
          "items": {
