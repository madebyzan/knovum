{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceWireSchemas",
  "type": "object",
  "properties": {
    "initialize_params": {
      "$ref": "#/$defs/RuntimeInitializeParams"
    },
