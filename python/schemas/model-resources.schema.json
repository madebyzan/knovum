{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DownloadRequest",
  "type": "object",
  "properties": {
    "directory": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/HubSource"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SnapshotFile"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "directory",
    "source",
    "files"
  ],
  "$defs": {
    "HubSource": {
      "oneOf": [
        {
          "title": "HuggingFaceSource",
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "hugging_face"
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "repository",
            "revision",
            "endpoint"
          ]
        },
        {
          "title": "ModelScopeSource",
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "model_scope"
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "repository",
            "revision"
          ]
        }
      ]
    },
    "SnapshotFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ]
    }
  }
}