{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssistantWireSchemas",
  "type": "object",
  "properties": {
    "initialize": {
      "$ref": "#/$defs/AssistantInitialize"
    },
    "ready": {
      "$ref": "#/$defs/AssistantReady"
    },
    "prune_threads": {
      "$ref": "#/$defs/AssistantPruneThreads"
    },
    "execute": {
      "$ref": "#/$defs/AssistantExecute"
    },
    "execution_result": {
      "$ref": "#/$defs/AssistantExecutionResult"
    },
    "control": {
      "$ref": "#/$defs/AssistantControl"
    },
    "projection_request": {
      "$ref": "#/$defs/AssistantProjectionRequest"
    },
    "projection": {
      "$ref": "#/$defs/AssistantProjection"
    },
    "delta": {
      "$ref": "#/$defs/AssistantContentDelta"
    },
    "tool_invocation": {
      "$ref": "#/$defs/AssistantToolInvocation"
    },
    "tool_outcome": {
      "$ref": "#/$defs/AssistantToolOutcome"
    },
    "model_admission": {
      "$ref": "#/$defs/AssistantModelAdmission"
    },
    "model_completion": {
      "$ref": "#/$defs/AssistantModelCompletion"
    },
    "model_failure": {
      "$ref": "#/$defs/AssistantModelFailure"
    },
    "tool_admission": {
      "$ref": "#/$defs/AssistantToolAdmission"
    }
  },
  "required": [
    "initialize",
    "ready",
    "prune_threads",
    "execute",
    "execution_result",
    "control",
    "projection_request",
    "projection",
    "delta",
    "tool_invocation",
    "tool_outcome",
    "model_admission",
    "model_completion",
    "model_failure",
    "tool_admission"
  ],
  "$defs": {
    "AssistantInitialize": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "graphVersion": {
          "type": "string"
        },
        "checkpointPath": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "graphVersion",
        "checkpointPath"
      ]
    },
    "AssistantReady": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "graphVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "graphVersion"
      ]
    },
    "AssistantPruneThreads": {
      "type": "object",
      "properties": {
        "threadIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retainedThreadIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphanBeforeMs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "threadIds",
        "retainedThreadIds",
        "orphanBeforeMs"
      ]
    },
    "AssistantExecute": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "model": {
          "$ref": "#/$defs/AssistantModelBinding"
        },
        "systemPrompt": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantToolDefinition"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantInputMessage"
          }
        },
        "inputId": {
          "type": "string"
        },
        "afterCheckpointId": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume": true,
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "plan": {
          "type": "boolean"
        },
        "research": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "model",
        "systemPrompt",
        "tools",
        "messages",
        "inputId",
        "skills",
        "memory",
        "plan",
        "research"
      ]
    },
    "AssistantExecutionIdentity": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "executionRevision": {
          "type": "string"
        },
        "controlEpoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "runId",
        "threadId",
        "executionRevision",
        "controlEpoch"
      ]
    },
    "AssistantModelBinding": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ChatModelProtocol"
        },
        "model": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        },
        "apiVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "apiKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "maxOutputTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxInputTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol",
        "model",
        "baseUrl",
        "maxOutputTokens",
        "maxInputTokens"
      ]
    },
    "ChatModelProtocol": {
      "type": "string",
      "enum": [
        "open_ai_chat",
        "open_ai_responses",
        "anthropic",
        "gemini",
        "ollama",
        "deep_seek",
        "groq"
      ]
    },
    "AssistantToolDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": true,
        "readOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters",
        "readOnly"
      ]
    },
    "AssistantInputMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AssistantInputRole"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantContentPart"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "content"
      ]
    },
    "AssistantInputRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "AssistantContentPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mimeType": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "mimeType",
            "data"
          ]
        }
      ]
    },
    "AssistantExecutionResult": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "checkpointId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AssistantExecutionState"
        },
        "interrupts": {
          "type": "array",
          "items": true
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "checkpointId",
        "state",
        "interrupts"
      ]
    },
    "AssistantExecutionState": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted"
      ]
    },
    "AssistantControl": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "operation": {
          "$ref": "#/$defs/AssistantControlOperation"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "operation"
      ]
    },
    "AssistantControlOperation": {
      "type": "string",
      "enum": [
        "pause",
        "cancel"
      ]
    },
    "AssistantProjectionRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "afterCheckpointId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "threadId"
      ]
    },
    "AssistantProjection": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "checkpointId": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantProjectedMessage"
          }
        },
        "acceptedInputIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantPlanItem"
          }
        },
        "modelCheckpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantModelCheckpoint"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "threadId",
        "checkpointId",
        "messages",
        "acceptedInputIds",
        "plan",
        "modelCheckpoints"
      ]
    },
    "AssistantProjectedMessage": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "messageId",
        "text"
      ]
    },
    "AssistantPlanItem": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AssistantPlanState"
        }
      },
      "additionalProperties": false,
      "required": [
        "content",
        "state"
      ]
    },
    "AssistantPlanState": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ]
    },
    "AssistantModelCheckpoint": {
      "type": "object",
      "properties": {
        "graphNamespace": {
          "type": "string"
        },
        "messageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "graphNamespace",
        "messageIds",
        "requestIds"
      ]
    },
    "AssistantContentDelta": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "messageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "messageId",
        "text"
      ]
    },
    "AssistantToolInvocation": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "graphNamespace": {
          "type": "string"
        },
        "checkpointId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "toolCallId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": true
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "graphNamespace",
        "checkpointId",
        "messageId",
        "toolCallId",
        "name",
        "arguments"
      ]
    },
    "AssistantToolOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": true,
            "media": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AssistantContentPart"
              }
            },
            "type": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "media"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "await_child"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "runId"
          ]
        }
      ]
    },
    "AssistantModelAdmission": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "requestId": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/AssistantModelPurpose"
        },
        "checkpointId": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimatedInputTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "graphNamespace": {
          "type": "string"
        },
        "maxOutputTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "requestId",
        "purpose",
        "estimatedInputTokens",
        "graphNamespace",
        "maxOutputTokens"
      ]
    },
    "AssistantModelPurpose": {
      "type": "string",
      "enum": [
        "main",
        "research",
        "context_summary"
      ]
    },
    "AssistantModelCompletion": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "requestId": {
          "type": "string"
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "messageId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "requestId"
      ]
    },
    "AssistantModelFailure": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "requestId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "requestId"
      ]
    },
    "AssistantToolAdmission": {
      "type": "object",
      "properties": {
        "siblingTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity": {
          "$ref": "#/$defs/AssistantExecutionIdentity"
        },
        "graphNamespace": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "toolCallId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "siblingTools",
        "identity",
        "graphNamespace",
        "messageId",
        "toolCallId",
        "name"
      ]
    }
  }
}