{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceActionParameters",
  "type": "object",
  "properties": {
    "upscale-image": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "generate-image-angle": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "remove-image-object": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "remove-image-background": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "extract-image-selection": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "generate-image-depth": {
      "$ref": "#/$defs/ImageTransformParameters"
    },
    "split-image-layers": {
      "$ref": "#/$defs/EmptyParameters"
    },
    "create-note": {
      "$ref": "#/$defs/NoteParameters"
    },
    "commit-knowledge-changes": {
      "$ref": "#/$defs/KnowledgeChangesParameters"
    },
    "edit-space-structure": {
      "$ref": "#/$defs/SpaceEditParameters"
    },
    "list-space-contents": {
      "$ref": "#/$defs/ContentsParameters"
    },
    "search-knowledge": {
      "$ref": "#/$defs/SearchParameters"
    },
    "read-node": {
      "$ref": "#/$defs/NodeParameters"
    },
    "answer-with-sources": {
      "$ref": "#/$defs/QuestionParameters"
    },
    "draft-document": {
      "$ref": "#/$defs/PurposeParameters"
    },
    "draft-script": {
      "$ref": "#/$defs/ScriptParameters"
    },
    "summarize-meeting": {
      "$ref": "#/$defs/MeetingSummaryParameters"
    },
    "draft-social-post": {
      "$ref": "#/$defs/SocialCopyParameters"
    },
    "generate-visualization": {
      "$ref": "#/$defs/VisualizationParameters"
    },
    "generate-image": {
      "$ref": "#/$defs/ImageParameters"
    },
    "generate-video": {
      "$ref": "#/$defs/VideoParameters"
    },
    "add-video-subtitles": {
      "$ref": "#/$defs/EmptyParameters"
    }
  },
  "$defs": {
    "ImageOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "targetLongEdge": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "upscale"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "targetLongEdge"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/ImageViewMode"
            },
            "yaw": {
              "type": "integer",
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "pitch": {
              "type": "integer",
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "zoom": {
              "$ref": "#/$defs/ImageZoom"
            },
            "kind": {
              "type": "string",
              "const": "multi-angle"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "mode",
            "yaw",
            "pitch",
            "zoom"
          ]
        },
        {
          "type": "object",
          "properties": {
            "strokes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MaskStroke"
              }
            },
            "kind": {
              "type": "string",
              "const": "remove-object"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "strokes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remove-background"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selection": {
              "$ref": "#/$defs/ImageSelection"
            },
            "kind": {
              "type": "string",
              "const": "extract-selection"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "selection": {
              "$ref": "#/$defs/ImageSelection"
            },
            "selectionModel": {
              "$ref": "#/$defs/LocalModelId"
            },
            "selectionSpecId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "remove-selected-object"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection",
            "selectionModel",
            "selectionSpecId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generate-depth"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "remove-object-prompt"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "prompt"
          ]
        }
      ]
    },
    "ImageViewMode": {
      "type": "string",
      "enum": [
        "subject",
        "camera"
      ]
    },
    "ImageZoom": {
      "type": "string",
      "enum": [
        "close",
        "medium",
        "wide"
      ]
    },
    "MaskStroke": {
      "type": "object",
      "properties": {
        "diameter": {
          "type": "number",
          "format": "double"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "diameter",
        "points"
      ]
    },
    "ImageSelection": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImageSelectionPoint"
          }
        },
        "boxRect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageSelectionRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaskStroke"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "points",
        "strokes"
      ]
    },
    "ImageSelectionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "foreground": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "foreground"
      ]
    },
    "ImageSelectionRect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "width": {
          "type": "number",
          "format": "float"
        },
        "height": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "LocalModelId": {
      "type": "string",
      "enum": [
        "qwen3Embedding",
        "whisperSmall",
        "whisperTiny",
        "whisperLargeV3",
        "mossNano",
        "voxCpm2",
        "voxCpm2Q8",
        "qwen3Aligner",
        "qwen3AlignerQ8",
        "u2netp",
        "u2net",
        "realEsrganGeneralX4v3",
        "realEsrganX4plus",
        "migan",
        "efficientSamTi",
        "efficientSamS",
        "depthAnythingV2SmallUint8",
        "depthAnythingV2Small",
        "spleeter2Stems",
        "spleeter2StemsFull",
        "sherpaDiarization",
        "sherpaDiarizationFull"
      ]
    },
    "ImageExecutionTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/LocalModelId"
            },
            "specId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "local"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "model",
            "specId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "$ref": "#/$defs/TaskTargetRef"
            },
            "type": {
              "type": "string",
              "const": "remote"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ]
        }
      ]
    },
    "TaskTargetRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string"
            },
            "modelId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "model"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "connectionId",
            "modelId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "runtimeKind": {
              "$ref": "#/$defs/ExternalAgentKind"
            },
            "type": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "runtimeKind"
          ]
        }
      ]
    },
    "ExternalAgentKind": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "gemini_cli",
        "github_copilot",
        "open_code",
        "qwen_code",
        "qoder_cli",
        "kimi_cli",
        "auggie_cli",
        "cline",
        "cursor",
        "antigravity"
      ]
    },
    "ImageTransformParameters": {
      "required": [
        "title",
        "operation",
        "execution"
      ],
      "title": "ImageTransformParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "operation": {
          "$ref": "#/$defs/ImageOperation"
        },
        "execution": {
          "$ref": "#/$defs/ImageExecutionTarget"
        }
      },
      "additionalProperties": false
    },
    "EmptyParameters": {
      "additionalProperties": false,
      "title": "EmptyParameters",
      "type": "object"
    },
    "NoteParameters": {
      "required": [
        "title",
        "content"
      ],
      "title": "NoteParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4194304
        }
      },
      "additionalProperties": false
    },
    "KnowledgeChangesParameters": {
      "required": [
        "operations"
      ],
      "title": "KnowledgeChangesParameters",
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "items": true
        }
      },
      "additionalProperties": false
    },
    "SpaceEditParameters": {
      "required": [
        "expectedEditRevision",
        "command"
      ],
      "title": "SpaceEditParameters",
      "type": "object",
      "properties": {
        "expectedEditRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "command": true
      },
      "additionalProperties": false
    },
    "ContentsParameters": {
      "required": [
        "offset",
        "limit"
      ],
      "title": "ContentsParameters",
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "format": "uint8",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "SearchParameters": {
      "required": [
        "query",
        "limit"
      ],
      "title": "SearchParameters",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "format": "uint8",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "NodeParameters": {
      "required": [
        "nodeId"
      ],
      "title": "NodeParameters",
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "QuestionParameters": {
      "required": [
        "question"
      ],
      "title": "QuestionParameters",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "PurposeParameters": {
      "required": [
        "title",
        "purpose"
      ],
      "title": "PurposeParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ScriptParameters": {
      "required": [
        "title",
        "prompt"
      ],
      "title": "ScriptParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "MeetingSummaryParameters": {
      "required": [
        "title",
        "summaryPurpose"
      ],
      "title": "MeetingSummaryParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summaryPurpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "SocialPlatform": {
      "type": "string",
      "enum": [
        "generic",
        "xiaohongshu",
        "linkedin"
      ]
    },
    "SocialTone": {
      "type": "string",
      "enum": [
        "professional",
        "friendly",
        "energetic"
      ]
    },
    "SocialCopyParameters": {
      "required": [
        "title",
        "platform",
        "audience",
        "goal",
        "tone"
      ],
      "title": "SocialCopyParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "platform": {
          "$ref": "#/$defs/SocialPlatform"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "$ref": "#/$defs/SocialTone"
        }
      },
      "additionalProperties": false
    },
    "ImageAspectRatio": {
      "type": "string",
      "enum": [
        "1:1",
        "3:2",
        "2:3",
        "16:9",
        "9:16"
      ]
    },
    "VisualizationParameters": {
      "required": [
        "title",
        "intent",
        "aspectRatio"
      ],
      "title": "VisualizationParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "aspectRatio": {
          "$ref": "#/$defs/ImageAspectRatio"
        }
      },
      "additionalProperties": false
    },
    "ImageParameters": {
      "required": [
        "title",
        "aspectRatio"
      ],
      "title": "ImageParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "aspectRatio": {
          "$ref": "#/$defs/ImageAspectRatio"
        }
      },
      "additionalProperties": false
    },
    "VideoAspectRatio": {
      "type": "string",
      "enum": [
        "1:1",
        "16:9",
        "9:16"
      ]
    },
    "VideoParameters": {
      "required": [
        "title",
        "prompt",
        "aspectRatio",
        "durationSeconds"
      ],
      "title": "VideoParameters",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "aspectRatio": {
          "$ref": "#/$defs/VideoAspectRatio"
        },
        "durationSeconds": {
          "type": "integer",
          "format": "uint16",
          "minimum": 5,
          "maximum": 15,
          "enum": [
            5,
            10,
            15
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}