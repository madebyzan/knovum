{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowDefinition",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "title": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkflowEdge"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/WorkflowNodeLayout"
      },
      "default": {}
    },
    "failurePolicy": {
      "$ref": "#/$defs/FailurePolicy"
    },
    "limits": {
      "$ref": "#/$defs/WorkflowLimits"
    }
  },
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "nodes", "edges", "failurePolicy", "limits"],
  "$defs": {
    "WorkflowNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "outputType": {
              "$ref": "#/$defs/WorkflowValueType"
            },
            "kind": {
              "type": "string",
              "const": "input"
            }
          },
          "required": ["kind", "id", "outputType"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "inputType": {
              "$ref": "#/$defs/WorkflowValueType"
            },
            "kind": {
              "type": "string",
              "const": "output"
            }
          },
          "required": ["kind", "id", "inputType"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "actionId": {
              "type": "string"
            },
            "actionVersion": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535
            },
            "parameters": true,
            "kind": {
              "type": "string",
              "const": "action"
            }
          },
          "required": ["kind", "id", "actionId", "actionVersion", "parameters"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "condition"
            }
          },
          "required": ["kind", "id", "expression"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "parallel"
            }
          },
          "required": ["kind", "id"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "policy": {
              "$ref": "#/$defs/JoinPolicy"
            },
            "kind": {
              "type": "string",
              "const": "join"
            }
          },
          "required": ["kind", "id", "policy"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "maxItems": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "parallelism": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535
            },
            "errorPolicy": {
              "$ref": "#/$defs/ItemErrorPolicy"
            },
            "kind": {
              "type": "string",
              "const": "for_each"
            }
          },
          "required": ["kind", "id", "maxItems", "parallelism", "errorPolicy"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "maxIterations": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535
            },
            "stopExpression": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "iterate"
            }
          },
          "required": ["kind", "id", "maxIterations", "stopExpression"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "workflowId": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "subworkflow"
            }
          },
          "required": ["kind", "id", "workflowId", "version"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "schema": true,
            "kind": {
              "type": "string",
              "const": "human_input"
            }
          },
          "required": ["kind", "id", "schema"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "review"
            }
          },
          "required": ["kind", "id", "purpose"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "durationSeconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "delay"
            }
          },
          "required": ["kind", "id", "durationSeconds"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "data_transform"
            }
          },
          "required": ["kind", "id", "expression"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "bindingId": {
              "type": "string"
            },
            "schemaFingerprint": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "external_tool"
            }
          },
          "required": ["kind", "id", "bindingId", "schemaFingerprint"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "runtimeId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "delegate_task"
            }
          },
          "required": ["kind", "id", "runtimeId"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/PublicationMode"
            },
            "destination": {
              "type": ["string", "null"]
            },
            "kind": {
              "type": "string",
              "const": "publish"
            }
          },
          "required": ["kind", "id", "mode"]
        }
      ]
    },
    "WorkflowValueType": {
      "type": "string",
      "enum": [
        "value",
        "record",
        "boolean",
        "document",
        "image",
        "audio",
        "video",
        "transcript",
        "subtitle",
        "presentation",
        "resource_revision",
        "collection"
      ]
    },
    "JoinPolicy": {
      "type": "string",
      "enum": ["all_succeeded", "active_branches", "collect_results"]
    },
    "ItemErrorPolicy": {
      "type": "string",
      "enum": ["stop", "collect_errors"]
    },
    "PublicationMode": {
      "type": "string",
      "enum": ["create_resource", "update_expected_revision", "export"]
    },
    "WorkflowEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": "string"
        },
        "sourcePort": {
          "$ref": "#/$defs/WorkflowPort"
        },
        "targetNodeId": {
          "type": "string"
        },
        "targetPort": {
          "$ref": "#/$defs/WorkflowPort"
        },
        "branch": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "required": ["id", "sourceNodeId", "sourcePort", "targetNodeId", "targetPort"]
    },
    "WorkflowPort": {
      "type": "string",
      "enum": ["input", "output"]
    },
    "WorkflowNodeLayout": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["x", "y"]
    },
    "FailurePolicy": {
      "type": "string",
      "enum": ["stop_run", "continue_independent", "collect_errors"]
    },
    "WorkflowLimits": {
      "type": "object",
      "properties": {
        "maxExpandedSteps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxParallelism": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "maxDurationSeconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxTotalTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxStepAttempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxInputBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxOutputBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxExpandedSteps",
        "maxParallelism",
        "maxDurationSeconds",
        "maxTotalTokens",
        "maxStepAttempts",
        "maxInputBytes",
        "maxOutputBytes"
      ]
    }
  }
}
